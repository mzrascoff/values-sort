# Upstash Redis (Vercel KV via the Upstash Marketplace integration).
# When you add the Upstash integration on Vercel these are set automatically.
# For local dev, copy this file to .env.local and fill in from the Upstash console.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# The code also accepts the native Upstash variable names as a fallback:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
